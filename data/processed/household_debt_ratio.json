{
  "id": "household_debt_ratio",
  "label": "Household debt to income",
  "category": "economy",
  "unit": "%",
  "unit_label": "%",
  "frequency": "quarterly",
  "source": "RBA Table E2",
  "source_url": "https://www.rba.gov.au/statistics/tables/",
  "description": "Total household debt (mortgages, personal loans, credit cards) as a percentage of annual household disposable income. Australia is consistently among the world's highest.",
  "explainer": "This ratio shows how much debt households carry relative to their income. A ratio of 200% means the average household owes two years' worth of income. Australia's ratio has grown from around 40% in the late 1970s to nearly 190% today \u2014 almost entirely driven by mortgage debt and rising house prices. This makes Australian households unusually sensitive to interest rate changes.",
  "projection_source": "RBA Financial Stability Review. Assumes gradual deleveraging as interest rates moderate and housing credit growth slows.",
